  // Load custom marker icons
  map.loadImage('/modules/custom/rdasa_mapping/images/lock-open-128.png', (err, img) => {
    if (err) throw err;
    if (!map.hasImage('lock-open')) map.addImage('lock-open', img);
  });
  map.loadImage('/modules/custom/rdasa_mapping/images/lock-solid-128.png', (err, img) => {
    if (err) throw err;
    if (!map.hasImage('lock-solid')) map.addImage('lock-solid', img);
  });

  var points = {
    'type': 'geojson',
    'data': {
      'type': 'FeatureCollection',
      'features': [
        {% for coordinate in mapbox.coordinates %}
        {
          'type': 'Feature',
          'geometry': {
            'type': 'Point',
            'coordinates': [{{ coordinate.1 }}, {{ coordinate.0 }}]
          },
    'properties': {
      'icon': '{{ coordinate.4 == "Yes" ? "lock-open" : "lock-solid" }}',
      'title': '{{ coordinate.2|escape('js') }}',
      'description': '{{ coordinate.3|escape('js') }}',
      'public': '{{ coordinate.4 }}',
      'nid': '{{ coordinate.5 }}'
}
        },
        {% endfor %}
      ]
    }
  };

// Adding map marker clustering

map.on('load', () => {
  document.getElementById('style-switcher').addEventListener('click', (e) => {
    if (e.target.tagName === 'BUTTON') {
      const newStyle = e.target.getAttribute('data-style');
      const currentData = map.getSource('projects')._data;

      map.setStyle(newStyle);

      map.once('styledata', () => {
        map.loadImage('/modules/custom/rdasa_mapping/images/lock-open-128.png', (err, img) => {
          if (!err && !map.hasImage('lock-open')) map.addImage('lock-open', img);
        });
        map.loadImage('/modules/custom/rdasa_mapping/images/lock-solid-128.png', (err, img) => {
          if (!err && !map.hasImage('lock-solid')) map.addImage('lock-solid', img);
        });

        map.addSource('projects', {
          type: 'geojson',
          data: currentData,
          cluster: true,
          clusterMaxZoom: 14,
          clusterRadius: 50
        });

        map.addLayer({
          id: 'clusters',
          type: 'circle',
          source: 'projects',
          filter: ['has', 'point_count'],
          paint: {
            'circle-color': '#1b998b',
            'circle-radius': ['step', ['get', 'point_count'], 15, 10, 25, 30, 35]
          }
        });

        map.addLayer({
          id: 'cluster-count',
          type: 'symbol',
          source: 'projects',
          filter: ['has', 'point_count'],
          layout: {
            'text-field': '{point_count_abbreviated}',
            'text-font': ['Open Sans Bold', 'Arial Unicode MS Bold'],
            'text-size': 12
          }
        });

        map.addLayer({
          id: 'unclustered-point',
          type: 'symbol',
          source: 'projects',
          filter: ['!', ['has', 'point_count']],
          layout: {
            'icon-image': ['get', 'icon'],
            'icon-size': 0.3,
            'text-field': ['get', 'title'],
            'text-anchor': 'top',
            'text-offset': [0, 1.5],
            'icon-allow-overlap': true,
            'text-allow-overlap': true
          },
          paint: {
            'text-color': '#1b1b1b',
            'text-halo-color': '#ffffff',
            'text-halo-width': 1.5,
            'text-halo-blur': 0.5
          }
        });
      });
    }
  });
    console.log('Map render triggered');
  map.addSource('projects', {
    type: 'geojson',
    data: points.data,
    cluster: true,
    clusterMaxZoom: 14,
    clusterRadius: 50
  });

  map.addLayer({
    id: 'clusters',
    type: 'circle',
    source: 'projects',
    filter: ['has', 'point_count'],
    paint: {
      'circle-color': '#1b998b',
      'circle-radius': ['step', ['get', 'point_count'], 15, 10, 25, 30, 35]
    }
  });

  map.addLayer({
    id: 'cluster-count',
    type: 'symbol',
    source: 'projects',
    filter: ['has', 'point_count'],
    layout: {
      'text-field': '{point_count_abbreviated}',
      'text-font': ['Open Sans Bold', 'Arial Unicode MS Bold'],
      'text-size': 12
    }
  });

map.addLayer({
  id: 'unclustered-point',
  type: 'symbol',
  source: 'projects',
  filter: ['!', ['has', 'point_count']],
  layout: {
    'icon-image': ['get', 'icon'],
    'icon-size': 0.25,
    'text-field': ['get', 'title'],
    'text-anchor': 'top',
    'text-offset': [0, 1.5],
    'icon-allow-overlap': true,
    'text-allow-overlap': true
  },
      paint: {
    'icon-color': [
      'match',
      ['get', 'public'],
      'Yes', '#1b998b',   // green for public
      'No',  '#d90368',   // pink for private
  '#999999'  // fallback color
  ],
  'text-color': '#1b1b1b',
  'text-halo-color': '#ffffff',
  'text-halo-width': 1.5,
  'text-halo-blur': 0.5
}
  });

  map.on('click', 'clusters', (e) => {
    const features = map.queryRenderedFeatures(e.point, {
      layers: ['clusters']
    });
    const clusterId = features[0].properties.cluster_id;
    map.getSource('projects').getClusterExpansionZoom(clusterId, (err, zoom) => {
      if (err) return;
      map.flyTo({
        center: features[0].geometry.coordinates,
        zoom: zoom
      });
    });
  });

  map.on('click', 'unclustered-point', (e) => {
    const coordinates = e.features[0].geometry.coordinates.slice();
    const description = e.features[0].properties.description;
    new mapboxgl.Popup()
      .setLngLat(coordinates)
      .setHTML(description)
      .addTo(map);
  });
});

