{{ attach_library('rdasa_mapping/single-node-map') }}

<div class="map-style-toggle">
  <button data-style="streets-v12">Street View</button>
  <button data-style="satellite-streets-v12">Satellite View</button>
</div>
<div id="map" class="mapbox-map"></div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    mapboxgl.accessToken = '{{ mapbox.accessToken }}';

    const map = new mapboxgl.Map({
      container: 'single-node-map',
    // Choose from Mapbox's core styles, or make your own style with Mapbox Studio
    style: 'mapbox://styles/wecollaborate/cmat919qt01it01spbxt1chnl',
    //    default: 'mapbox://styles/mapbox/streets-v12',
      center: [{{ mapbox.position.lng }}, {{ mapbox.position.lat }}],
      zoom: 7
    });

    map.on('load', () => {
      const el = document.createElement('div');
      el.className = '{{ mapbox.public == "Yes" ? "marker" : "marker-red" }}';

      const popup = new mapboxgl.Popup({ offset: 25 }).setHTML(`
        <p>{{ mapbox.description|raw }}</p>
      `);

      new mapboxgl.Marker(el)
        .setLngLat([{{ mapbox.position.lng }}, {{ mapbox.position.lat }}])
        .setPopup(popup)
        .addTo(map);
    });
  });
</script>
