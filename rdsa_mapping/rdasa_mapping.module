   *
   * page__group__group_map

  return array(
    'views_view_unformatted_projects_map' => [
      'variables' => [
        'mapbox' => NULL,
      ],
      'template' => 'views-view-unformatted-projects-map',
      'base hook' => 'views_view_unformatted',
    ],
    'views_view_fields_projects_map' => [
      'variables' => [
